---
import '@fontsource-variable/nunito';
import '../styles/global.css';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import appIcon from '../assets/app_icon.png';
import { type Lang, type Page, SOURCE_URL, pageUrl, ui } from '../site';

interface Props {
	lang: Lang;
	// Omitted on the 404 page, which has no counterpart page; the language switch then goes home.
	page?: Page;
	title: string;
	description: string;
	noindex?: boolean;
}

const { lang, page, title, description, noindex = false } = Astro.props;
const t = ui[lang];
const otherLang: Lang = lang === 'en' ? 'tr' : 'en';
const otherLangUrl = pageUrl(otherLang, page ?? 'home');
const base = import.meta.env.BASE_URL;
const navPages = ['privacy', 'support'] as const;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<!-- Applies a saved theme before first paint. The choice lives only in this browser's localStorage. -->
		<script is:inline>
			try {
				const theme = localStorage.getItem('patilog-theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">{t.skip}</a>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href={pageUrl(lang, 'home')}>
					<Image src={appIcon} alt="" width={36} height={36} densities={[2, 3]} />
					<span>Patilog</span>
				</a>
				<nav class="header-nav" aria-label={t.mainNav}>
					{navPages.map((p) => (
						<a href={pageUrl(lang, p)} aria-current={p === page ? 'page' : undefined}>{t[p]}</a>
					))}
					{SOURCE_URL && (
						<a class="icon-link" href={SOURCE_URL} aria-label={t.sourceOnGithub} title={t.sourceOnGithub}><Icon name="simple-icons:github" aria-hidden="true" /></a>
					)}
				</nav>
				<button
					class="theme-toggle"
					type="button"
					hidden
					data-label={t.theme.label}
					data-light={t.theme.light}
					data-dark={t.theme.dark}
				>
					<Icon name="lucide:sun" class="theme-icon-light" aria-hidden="true" />
					<Icon name="lucide:moon" class="theme-icon-dark" aria-hidden="true" />
				</button>
				<a class="lang-switch" href={otherLangUrl} hreflang={otherLang} lang={otherLang} aria-label={t.otherLang}>
					<Icon name="lucide:languages" aria-hidden="true" />
					<span class="lang-full">{t.otherLang}</span>
					<span class="lang-short" aria-hidden="true">{otherLang.toUpperCase()}</span>
				</a>
				<details class="mobile-menu">
					<summary class="menu-toggle">
						<Icon name="lucide:menu" class="icon-open" aria-hidden="true" />
						<Icon name="lucide:x" class="icon-close" aria-hidden="true" />
						<span class="sr-only">{t.menu}</span>
					</summary>
					<nav class="menu-panel" aria-label={t.mainNav}>
						<ul>
							{navPages.map((p) => (
								<li><a href={pageUrl(lang, p)} aria-current={p === page ? 'page' : undefined}>{t[p]}</a></li>
							))}
							{SOURCE_URL && (
								<li><a href={SOURCE_URL}><Icon name="simple-icons:github" aria-hidden="true" />{t.sourceOnGithub}</a></li>
							)}
						</ul>
					</nav>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<div class="footer-brand">
					<strong>Patilog</strong>
					<span>{t.tagline}</span>
				</div>
				<ul class="footer-links">
					{(['home', 'privacy', 'support'] as const).map((p) => (
						<li><a href={pageUrl(lang, p)} aria-current={p === page ? 'page' : undefined}>{t[p]}</a></li>
					))}
					{SOURCE_URL && <li><a href={SOURCE_URL}>{t.sourceCode}</a></li>}
					<li><a href={otherLangUrl} hreflang={otherLang} lang={otherLang}>{t.otherLang}</a></li>
				</ul>
			</div>
		</footer>

		<!-- Theme toggle: switches between light and dark. Until the visitor picks one, the site follows the system
		     setting and the button shows the theme currently in effect, so every click visibly changes the theme.
		     Without JavaScript the button stays hidden and the site follows the system setting. -->
		<script is:inline>
			(() => {
				const button = document.querySelector('.theme-toggle');
				if (!button) return;
				const root = document.documentElement;
				const systemDark = matchMedia('(prefers-color-scheme: dark)');
				const current = () => root.dataset.theme || (systemDark.matches ? 'dark' : 'light');
				const render = () => {
					const mode = current();
					button.dataset.mode = mode;
					button.setAttribute('aria-label', `${button.dataset.label}: ${button.dataset[mode]}`);
					button.title = button.getAttribute('aria-label');
				};
				render();
				// Keep the icon right if the system theme changes while no choice is saved.
				systemDark.addEventListener('change', render);
				button.hidden = false;
				button.addEventListener('click', () => {
					const next = current() === 'dark' ? 'light' : 'dark';
					root.dataset.theme = next;
					try {
						localStorage.setItem('patilog-theme', next);
					} catch {}
					render();
				});
			})();
		</script>
	</body>
</html>
